* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei";
    font-size: 13px;
    color: @textPrimary;
    outline: none;
}

QMainWindow {
    background: @pageBackground;
}
QDialog {
    background: @surface;
}
QDialog QLabel {
    color: @textPrimary;
}
QLabel[class="settingsSectionTitle"] {
    color: @textPrimary;
    font-size: 14px;
    font-weight: 600;
}
QLineEdit, QComboBox, QSpinBox {
    background: @surfaceAlt;
    color: @textPrimary;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: @accent;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: @surface;
    color: @textPrimary;
    border: none;
    selection-background-color: @accentSoft;
    selection-color: @accent;
}
QCheckBox {
    color: @textPrimary;
    spacing: 8px;
}

/* ---------- 标题栏 ---------- */
QWidget#titleBar {
    background: @pageBackground;
}
QLineEdit#searchEdit {
    background: @surfaceAlt;
    border: none;
    border-radius: 18px;
    padding: 0 12px;
    color: @textPrimary;
    selection-background-color: @accent;
}
QLineEdit#searchEdit:focus {
    background: @surfaceHover;
}
QPushButton[class="winBtn"] {
    border: none;
    background: @pageBackground;
    border-radius: 6px;
    padding: 0;
}
QPushButton[class="winBtn"]:hover {
    background: @surfaceAlt;
}
QPushButton[class="winBtn"]:pressed {
    background: @surfaceHover;
}
QPushButton[class="winClose"] {
    border: none;
    background: @pageBackground;
    border-radius: 6px;
    padding: 0;
}
QPushButton[class="winClose"]:hover {
    background: @accent;
}

/* ---------- 侧栏 ---------- */
QWidget#sidebar {
    background: @pageBackground;
}
QLabel[class="sectionTitle"] {
    color: @textTertiary;
    font-size: 12px;
    letter-spacing: 1px;
}
QPushButton[nav="true"] {
    text-align: center;
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    background: @pageBackground;
    color: @textSecondary;
    font-size: 15px;
}
QPushButton[nav="true"]:hover {
    background: @surfaceAlt;
    color: @accentHover;
}
QPushButton[nav="true"]:checked {
    background: @surfaceAlt;
    color: @accent;
    font-weight: 600;
}
QPushButton[class="playlistBtn"] {
    text-align: left;
    padding: 7px 10px;
    border: none;
    border-radius: 6px;
    background: @pageBackground;
    color: @textSecondary;
}
QPushButton[class="playlistBtn"]:hover {
    background: @surfaceAlt;
    color: @accentHover;
}
QPushButton[class="playlistBtn"]:checked {
    background: @surfaceAlt;
    color: @accent;
    font-weight: 600;
}
QPushButton#createPlaylistBtn {
    border: none;
    border-radius: 6px;
    color: @textSecondary;
    background: @surfaceAlt;
    padding: 7px 10px;
}
QPushButton#createPlaylistBtn:hover {
    background: @accentSoft;
    color: @accent;
}

/* ---------- 内容区 ---------- */
QStackedWidget#contentStack {
    background: @pageBackground;
    border: none;
}
QScrollArea, QScrollArea > QWidget > QWidget {
    background: @pageBackground;
    border: none;
}
QLabel[class="pageTitle"] {
    font-size: 20px;
    font-weight: 700;
    color: @textPrimary;
}
QLabel[class="rowTitle"] {
    font-size: 16px;
    font-weight: 700;
    color: @textPrimary;
}
QLabel[class="timeLabel"] {
    color: @textTertiary;
    font-size: 12px;
}
QPushButton#neteaseSourceSwitch, QPushButton#qqSourceSwitch {
    border: none;
    border-radius: 8px;
    padding: 0 12px;
    background: @surfaceAlt;
    color: @textSecondary;
    font-weight: 500;
}
QPushButton#neteaseSourceSwitch:hover, QPushButton#qqSourceSwitch:hover {
    background: @surfacePressed;
    color: @accentHover;
}
QPushButton#neteaseSourceSwitch:checked, QPushButton#qqSourceSwitch:checked {
    background: @accent;
    color: @textOnAccent;
    font-weight: 600;
}
QPushButton#neteaseSourceSwitch:pressed, QPushButton#qqSourceSwitch:pressed {
    background: @accentPressed;
    color: @textOnAccent;
}

/* ---------- 底部播放器 ---------- */
QWidget#playerBar {
    background: @pageBackground;
}
QLabel[class="nowTitle"] {
    font-size: 14px;
    color: @textPrimary;
}
QLabel[class="nowSub"] {
    font-size: 12px;
    color: @textTertiary;
}
QPushButton[class="ctrlBtn"] {
    border: none;
    border-radius: 15px;
    background: transparent;
    padding: 3px;
    color: @textSecondary;
}
QPushButton[class="ctrlBtn"]:hover {
    background: transparent;
    color: @textPrimary;
}
QPushButton#playPauseBtn {
    border: none;
    border-radius: 20px;
    background: transparent;
    padding: 0;
}
QPushButton#playPauseBtn:hover {
    background: transparent;
}
QPushButton#playPauseBtn:pressed {
    background: transparent;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: @pageBackground;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @progressTrack;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: @focus;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: @pageBackground;
}
QScrollBar:horizontal {
    background: @pageBackground;
    height: 0px;
    min-height: 0px;
    max-height: 0px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @pageBackground;
    border-radius: 4px;
    min-width: 0px;
}
QScrollBar::handle:horizontal:hover {
    background: @pageBackground;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: @pageBackground;
}

/* ---------- 账号区 / 账号对话框 / 歌单编辑 ---------- */
QWidget#accountPanel {
    background: @pageBackground;
}
QLabel[class="accountName"] {
    color: @textPrimary;
    font-size: 13px;
}
QPushButton[class="accountAction"] {
    border: none;
    border-radius: 8px;
    padding: 6px 8px;
    text-align: left;
    background: transparent;
    color: @textPrimary;
    font-size: 13px;
}
QPushButton[class="accountAction"]:hover {
    background: @surfaceAlt;
    color: @accentHover;
}
QPushButton[class="accountAction"]:pressed {
    background: @surfacePressed;
    color: @accentPressed;
}
QLabel[class="accountSub"] {
    color: @textTertiary;
    font-size: 11px;
}
QLabel[class="pageSub"] {
    color: @textSecondary;
    font-size: 13px;
}
QDialog#playlistEditDialog, QDialog#accountDialog {
    background: @surface;
}
QDialog#playlistEditDialog QLineEdit, QDialog#playlistEditDialog QPlainTextEdit,
QDialog#accountDialog QPushButton {
    background: @surfaceAlt;
    border: none;
    border-radius: 8px;
    color: @textPrimary;
    padding: 6px 10px;
    selection-background-color: @accent;
}
QDialog#playlistEditDialog QLineEdit:focus, QDialog#playlistEditDialog QPlainTextEdit:focus {
    border: 1px solid @accent;
}

/* ---------- 菜单 / 提示 / 对话框 ---------- */
QToolTip {
    background: @surfaceAlt;
    color: @textPrimary;
    border: none;
    padding: 4px 8px;
}
QMenu {
    background: @surfaceAlt;
    border: none;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    color: @textPrimary;
}
QMenu::item:selected {
    background: @surfaceHover;
}
QMenu::item:disabled {
    color: @disabledText;
}
QDialog QPushButton {
    border: none;
    border-radius: 6px;
    background: @surfaceAlt;
    color: @textPrimary;
    padding: 6px 18px;
}
QDialog QPushButton:hover {
    background: @accentSoft;
    color: @accentHover;
}
QDialog QPushButton[class="accent"] {
    background: @accent;
    color: @textOnAccent;
}
QDialog QPushButton[class="accent"]:hover {
    background: @accentHover;
    color: @textOnAccent;
}
QListWidget {
    background: @surface;
    border: none;
    border-radius: 6px;
    color: @textPrimary;
}
QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background: @accentSoft;
    color: @accentHover;
}
QPlainTextEdit {
    background: @surface;
    color: @textPrimary;
    border: none;
    border-radius: 6px;
    selection-background-color: @accent;
}
QSlider::groove:horizontal {
    height: 4px;
    background: @surfaceHover;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
    background: @accent;
}
