* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei";
    font-size: 13px;
    color: #E8E8E8;
    outline: none;
}

QPushButton, QToolButton, QListWidget, QTableView, QSlider {
    cursor: pointer;
}

QMainWindow {
    background: #0E0E14;
}
QDialog {
    background: #16161E;
}
QDialog QLabel {
    color: #E8E8E8;
}

/* ---------- 标题栏 ---------- */
QWidget#titleBar {
    background: #0E0E14;
}
QLabel#brandName {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #E8E8E8;
}
QLineEdit#searchEdit {
    background: #1B1B24;
    border: none;
    border-radius: 15px;
    padding: 0 12px;
    color: #E8E8E8;
    selection-background-color: #EC4141;
}
QLineEdit#searchEdit:focus {
    background: #2A2A36;
}
QPushButton[class="winBtn"] {
    border: none;
    background: #0E0E14;
    border-radius: 6px;
    padding: 0;
}
QPushButton[class="winBtn"]:hover {
    background: #1B1B24;
}
QPushButton[class="winBtn"]:pressed {
    background: #2A2A36;
}
QPushButton[class="winClose"] {
    border: none;
    background: #0E0E14;
    border-radius: 6px;
    padding: 0;
}
QPushButton[class="winClose"]:hover {
    background: #EC4141;
}

/* ---------- 侧栏 ---------- */
QWidget#sidebar {
    background: #0E0E14;
}
QLabel[class="sectionTitle"] {
    color: #6E6E7A;
    font-size: 12px;
    letter-spacing: 1px;
}
QPushButton[nav="true"] {
    text-align: center;
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    background: #0E0E14;
    color: #9A9AA5;
    font-size: 15px;
}
QPushButton[nav="true"]:hover {
    background: #1B1B24;
    color: #FF5A5A;
}
QPushButton[nav="true"]:checked {
    background: #1B1B24;
    color: #EC4141;
    font-weight: 600;
}
QPushButton[class="playlistBtn"] {
    text-align: left;
    padding: 7px 10px;
    border: none;
    border-radius: 6px;
    background: #0E0E14;
    color: #9A9AA5;
}
QPushButton[class="playlistBtn"]:hover {
    background: #1B1B24;
    color: #FF5A5A;
}
QPushButton[class="playlistBtn"]:checked {
    background: #1B1B24;
    color: #EC4141;
    font-weight: 600;
}
QPushButton#createPlaylistBtn {
    border: none;
    border-radius: 6px;
    color: #9A9AA5;
    background: #1B1B24;
    padding: 7px 10px;
}
QPushButton#createPlaylistBtn:hover {
    background: #3A2024;
    color: #EC4141;
}

/* ---------- 内容区 ---------- */
QStackedWidget#contentStack {
    background: #0E0E14;
    border: none;
}
QScrollArea, QScrollArea > QWidget > QWidget {
    background: #0E0E14;
    border: none;
}
QLabel[class="pageTitle"] {
    font-size: 20px;
    font-weight: 700;
    color: #E8E8E8;
}
QLabel[class="rowTitle"] {
    font-size: 16px;
    font-weight: 700;
    color: #E8E8E8;
}
QLabel[class="timeLabel"] {
    color: #6E6E7A;
    font-size: 12px;
}
QPushButton#neteaseSourceSwitch, QPushButton#qqSourceSwitch {
    border: none;
    border-radius: 8px;
    padding: 0 12px;
    background: #1B1B24;
    color: #9A9AA5;
    font-weight: 500;
}
QPushButton#neteaseSourceSwitch:hover, QPushButton#qqSourceSwitch:hover {
    background: #24242E;
    color: #F04A4A;
}
QPushButton#neteaseSourceSwitch:checked, QPushButton#qqSourceSwitch:checked {
    background: #EC4141;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#neteaseSourceSwitch:pressed, QPushButton#qqSourceSwitch:pressed {
    background: #D63838;
    color: #FFFFFF;
}

/* ---------- 底部播放器 ---------- */
QWidget#playerBar {
    background: #1B1B24;
}
QLabel[class="nowTitle"] {
    font-size: 14px;
    color: #E8E8E8;
}
QLabel[class="nowSub"] {
    font-size: 12px;
    color: #6E6E7A;
}
QPushButton[class="ctrlBtn"] {
    border: none;
    border-radius: 15px;
    background: #1B1B24;
    padding: 3px;
    color: #C8C8D0;
}
QPushButton[class="ctrlBtn"]:hover {
    background: #2A2A36;
    color: #E8E8E8;
}
QPushButton#playPauseBtn {
    border: none;
    border-radius: 20px;
    background: transparent;
    padding: 0;
}
QPushButton#playPauseBtn:hover {
    background: transparent;
}
QPushButton#playPauseBtn:pressed {
    background: transparent;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: #0E0E14;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #33333F;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #444450;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: #0E0E14;
}
QScrollBar:horizontal {
    background: #0E0E14;
    height: 0px;
    min-height: 0px;
    max-height: 0px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #0E0E14;
    border-radius: 4px;
    min-width: 0px;
}
QScrollBar::handle:horizontal:hover {
    background: #0E0E14;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: #0E0E14;
}

/* ---------- 账号区 / 账号对话框 / 歌单编辑 ---------- */
QWidget#accountPanel {
    background: #0E0E14;
}
QLabel[class="accountName"] {
    color: #E8E8E8;
    font-size: 13px;
}
QPushButton[class="accountAction"] {
    border: none;
    border-radius: 8px;
    padding: 6px 8px;
    text-align: left;
    background: transparent;
    color: #E8E8E8;
    font-size: 13px;
}
QPushButton[class="accountAction"]:hover {
    background: #1B1B24;
    color: #F04A4A;
}
QPushButton[class="accountAction"]:pressed {
    background: #24242E;
    color: #D63838;
}
QLabel[class="accountSub"] {
    color: #6E6E7A;
    font-size: 11px;
}
QLabel[class="pageSub"] {
    color: #9A9AA5;
    font-size: 13px;
}
QDialog#playlistEditDialog, QDialog#accountDialog {
    background: #16161E;
}
QDialog#playlistEditDialog QLineEdit, QDialog#playlistEditDialog QPlainTextEdit,
QDialog#accountDialog QPushButton {
    background: #1B1B24;
    border: none;
    border-radius: 8px;
    color: #E8E8E8;
    padding: 6px 10px;
    selection-background-color: #EC4141;
}
QDialog#playlistEditDialog QLineEdit:focus, QDialog#playlistEditDialog QPlainTextEdit:focus {
    border: 1px solid #EC4141;
}

/* ---------- 菜单 / 提示 / 对话框 ---------- */
QToolTip {
    background: #1B1B24;
    color: #E8E8E8;
    border: none;
    padding: 4px 8px;
}
QMenu {
    background: #1B1B24;
    border: none;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    color: #E8E8E8;
}
QMenu::item:selected {
    background: #2A2A36;
}
QMenu::item:disabled {
    color: #55555F;
}
QDialog QPushButton {
    border: none;
    border-radius: 6px;
    background: #1B1B24;
    color: #E8E8E8;
    padding: 6px 18px;
}
QDialog QPushButton:hover {
    background: #3A2024;
    color: #FF5A5A;
}
QDialog QPushButton[class="accent"] {
    background: #EC4141;
    color: #FFFFFF;
}
QDialog QPushButton[class="accent"]:hover {
    background: #FF5A5A;
    color: #FFFFFF;
}
QListWidget {
    background: #16161E;
    border: none;
    border-radius: 6px;
    color: #E8E8E8;
}
QListWidget::item {
    padding: 8px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background: #3A2024;
    color: #FF5A5A;
}
QPlainTextEdit {
    background: #16161E;
    color: #E8E8E8;
    border: none;
    border-radius: 6px;
    selection-background-color: #EC4141;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #2A2A36;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
    background: #EC4141;
}
